+
+    let Some(package) = package.as_object_mut() else {
+        bail!("Vendored Lake manifest package is not an object");
+    };
+    package.insert("type".to_owned(), serde_json::Value::String("path".to_owned()));
+    package.insert("dir".to_owned(), serde_json::Value::String(path_to_lake_string(&dir)));
+    package.insert("inherited".to_owned(), serde_json::Value::Bool(true));
+    package.remove("url");
+    package.remove("rev");
+    package.remove("inputRev");
+    package.remove("subDir");
+
+    Ok(())
+}
 
